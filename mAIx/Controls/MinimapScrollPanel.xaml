<!-- VS2022 미니맵 스타일 — STT ScrollViewer 컨텐츠 축소 미리보기 + Y 좌표 클릭 양방향 스크롤 -->
<UserControl x:Class="mAIx.Controls.MinimapScrollPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="80"
             Background="{DynamicResource ControlFillColorDefaultBrush}"
             Cursor="Hand">
    <Grid>
        <!-- 축소 렌더링 이미지 -->
        <Image x:Name="MinimapImage"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
        <!-- 현재 viewport 표시 사각형 -->
        <Border x:Name="ViewportIndicator"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                Background="#33007ACC"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Height="40"
                IsHitTestVisible="False"/>
        <!-- 클릭 캡처 레이어 -->
        <Canvas x:Name="ClickLayer"
                Background="Transparent"
                MouseLeftButtonDown="ClickLayer_MouseLeftButtonDown"
                MouseMove="ClickLayer_MouseMove"
                MouseLeftButtonUp="ClickLayer_MouseLeftButtonUp"/>
    </Grid>
</UserControl>
