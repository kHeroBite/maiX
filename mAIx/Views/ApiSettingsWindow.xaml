<ui:FluentWindow x:Class="mAIx.Views.ApiSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="API 관리"
                 Height="700" Width="750"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 타이틀바 -->
        <ui:TitleBar Grid.Row="0"
                     Title="API 관리"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <!-- 메인 콘텐츠 -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel>
                <!-- 기본 Provider 선택 -->
                <Border Margin="0,0,0,16" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="기본 Provider"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="DefaultProviderComboBox"
                                  AutomationProperties.AutomationId="DefaultProviderComboBox"
                                  Grid.Column="1"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="DefaultProviderComboBox_SelectionChanged">
                            <ComboBoxItem Content="Claude" Tag="Claude"/>
                            <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                            <ComboBoxItem Content="Gemini" Tag="Gemini"/>
                            <ComboBoxItem Content="Ollama" Tag="Ollama"/>
                            <ComboBoxItem Content="LM Studio" Tag="LMStudio"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Claude 설정 -->
                <Border x:Name="ClaudeBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Claude (Anthropic)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="ClaudeStatusText" Text="" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <ui:PasswordBox x:Name="ClaudeApiKeyBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="ClaudeApiKeyBox"
                                               PlaceholderText="sk-ant-..."
                                               RevealButtonEnabled="True"/>
                                <ui:Button x:Name="ClaudeTestButton" Grid.Column="2"
                                           AutomationProperties.AutomationId="ClaudeTestButton"
                                           Content="테스트" Margin="8,0,0,0"
                                           Width="70" Click="ClaudeTestButton_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ClaudeModelComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="ClaudeModelComboBox"
                                          IsEnabled="False"
                                          />
                            </Grid>
                            <!-- 고급 설정 -->
                            <Expander IsExpanded="False" Margin="0,4,0,0">
                                <Expander.Header>
                                    <TextBlock Text="고급 설정" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL" VerticalAlignment="Center"/>
                                    <ui:TextBox x:Name="ClaudeBaseUrlBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="ClaudeBaseUrlBox"
                                               Text="https://api.anthropic.com"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- OpenAI 설정 -->
                <Border x:Name="OpenAIBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="OpenAI" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="OpenAIStatusText" Text="" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <ui:PasswordBox x:Name="OpenAIApiKeyBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="OpenAIApiKeyBox"
                                               PlaceholderText="sk-..."
                                               RevealButtonEnabled="True"/>
                                <ui:Button x:Name="OpenAITestButton" Grid.Column="2"
                                           AutomationProperties.AutomationId="OpenAITestButton"
                                           Content="테스트" Margin="8,0,0,0"
                                           Width="70" Click="OpenAITestButton_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" VerticalAlignment="Center"/>
                                <ComboBox x:Name="OpenAIModelComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="OpenAIModelComboBox"
                                          IsEnabled="False"
                                          />
                            </Grid>
                            <!-- 고급 설정 -->
                            <Expander IsExpanded="False" Margin="0,4,0,0">
                                <Expander.Header>
                                    <TextBlock Text="고급 설정" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL" VerticalAlignment="Center"/>
                                    <ui:TextBox x:Name="OpenAIBaseUrlBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="OpenAIBaseUrlBox"
                                               Text="https://api.openai.com/v1"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Gemini 설정 -->
                <Border x:Name="GeminiBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Google Gemini" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="GeminiStatusText" Text="" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <ui:PasswordBox x:Name="GeminiApiKeyBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="GeminiApiKeyBox"
                                               PlaceholderText="AIzaSy..."
                                               RevealButtonEnabled="True"/>
                                <ui:Button x:Name="GeminiTestButton" Grid.Column="2"
                                           AutomationProperties.AutomationId="GeminiTestButton"
                                           Content="테스트" Margin="8,0,0,0"
                                           Width="70" Click="GeminiTestButton_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" VerticalAlignment="Center"/>
                                <ComboBox x:Name="GeminiModelComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="GeminiModelComboBox"
                                          IsEnabled="False"
                                          />
                            </Grid>
                            <!-- 고급 설정 -->
                            <Expander IsExpanded="False" Margin="0,4,0,0">
                                <Expander.Header>
                                    <TextBlock Text="고급 설정" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL" VerticalAlignment="Center"/>
                                    <ui:TextBox x:Name="GeminiBaseUrlBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="GeminiBaseUrlBox"
                                               Text="https://generativelanguage.googleapis.com/v1beta"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Ollama 설정 -->
                <Border x:Name="OllamaBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🦙" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Ollama (로컬)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="OllamaStatusText" Text="" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Base URL" VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="OllamaBaseUrlBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="OllamaBaseUrlBox"
                                           Text="http://localhost:11434"/>
                                <ui:Button x:Name="OllamaTestButton" Grid.Column="2"
                                           AutomationProperties.AutomationId="OllamaTestButton"
                                           Content="테스트" Margin="8,0,0,0"
                                           Width="70" Click="OllamaTestButton_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" VerticalAlignment="Center"/>
                                <ComboBox x:Name="OllamaModelComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="OllamaModelComboBox"
                                          IsEnabled="False"
                                          />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- LM Studio 설정 -->
                <Border x:Name="LMStudioBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥️" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="LM Studio (로컬)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="LMStudioStatusText" Text="" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Base URL" VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="LMStudioBaseUrlBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="LMStudioBaseUrlBox"
                                           Text="http://localhost:1234/v1"/>
                                <ui:Button x:Name="LMStudioTestButton" Grid.Column="2"
                                           AutomationProperties.AutomationId="LMStudioTestButton"
                                           Content="테스트" Margin="8,0,0,0"
                                           Width="70" Click="LMStudioTestButton_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" VerticalAlignment="Center"/>
                                <ComboBox x:Name="LMStudioModelComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="LMStudioModelComboBox"
                                          IsEnabled="False"
                                          />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 🎙 녹음 STT/LLM 설정 -->
                <Border x:Name="OaiRecordingBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎙" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="녹음 STT/LLM 설정" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">

                            <!-- 음성 모델 섹션 -->
                            <TextBlock Text="음성 모델" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- 실시간 STT 모델 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="실시간 STT 모델" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="RealtimeSttModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="RealtimeSttModelTextBox"
                                           PlaceholderText="gpt-4o-realtime-preview"/>
                            </Grid>

                            <!-- 화자분리 STT 모델 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="화자분리 STT 모델" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="TranscribeSttModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="TranscribeSttModelTextBox"
                                           PlaceholderText="gpt-4o-transcribe"/>
                            </Grid>

                            <!-- LLM 모델 섹션 -->
                            <TextBlock Text="LLM 모델" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- 주제어 추출 모델 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="주제어 추출" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="KeywordExtractModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="KeywordExtractModelTextBox"
                                           PlaceholderText="gpt-4o-mini"/>
                            </Grid>

                            <!-- 1분 요약 모델 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1분 요약" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="MinuteSummaryModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="MinuteSummaryModelTextBox"
                                           PlaceholderText="gpt-4o-mini"/>
                            </Grid>

                            <!-- 누적 요약 모델 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="누적 요약" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="CumulativeSummaryModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="CumulativeSummaryModelTextBox"
                                           PlaceholderText="gpt-4o-mini"/>
                            </Grid>

                            <!-- 최종 요약 모델 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="최종 요약" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="FinalSummaryModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="FinalSummaryModelTextBox"
                                           PlaceholderText="gpt-4o"/>
                            </Grid>

                            <!-- 주기/청크 설정 섹션 -->
                            <TextBlock Text="주기 / 청크 설정" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- 누적 요약 주기 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="누적요약 주기" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox x:Name="CumulativeIntervalComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="CumulativeIntervalComboBox"
                                          Width="160" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="3분" Tag="3"/>
                                    <ComboBoxItem Content="5분" Tag="5"/>
                                    <ComboBoxItem Content="10분" Tag="10"/>
                                    <ComboBoxItem Content="15분" Tag="15"/>
                                </ComboBox>
                            </Grid>

                            <!-- 청크 길이 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="청크 길이" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox x:Name="ChunkSecondsComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="ChunkSecondsComboBox"
                                          Width="160" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="5초" Tag="5"/>
                                    <ComboBoxItem Content="10초" Tag="10"/>
                                    <ComboBoxItem Content="15초" Tag="15"/>
                                </ComboBox>
                            </Grid>

                            <!-- VAD 설정 -->
                            <TextBlock Text="VAD (발화 감지) 설정" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,8,0,8"/>

                            <!-- 서버 VAD 사용 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="서버 VAD 사용" VerticalAlignment="Center" FontSize="12"/>
                                <ui:ToggleSwitch x:Name="VadEnabledToggle" Grid.Column="1"
                                                 AutomationProperties.AutomationId="VadEnabledToggle"
                                                 HorizontalAlignment="Left"/>
                            </Grid>

                            <!-- VAD 감도 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VAD 감도 (Threshold)" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="VadThresholdTextBox" Grid.Column="1"
                                            AutomationProperties.AutomationId="VadThresholdTextBox"
                                            PlaceholderText="0.0~1.0, 기본 0.5"
                                            Width="160" HorizontalAlignment="Left"/>
                            </Grid>

                            <!-- 발화 종료 침묵 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="발화 종료 침묵 (ms)" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="VadSilenceMsTextBox" Grid.Column="1"
                                            AutomationProperties.AutomationId="VadSilenceMsTextBox"
                                            PlaceholderText="100~3000, 기본 500"
                                            Width="160" HorizontalAlignment="Left"/>
                            </Grid>

                            <!-- 프리셋 버튼 -->
                            <TextBlock Text="모델 프리셋" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="PresetLowCostButton"
                                           AutomationProperties.AutomationId="PresetLowCostButton"
                                           Content="저비용형" Margin="0,0,8,0"
                                           Click="PresetLowCostButton_Click"/>
                                <ui:Button x:Name="PresetQualityButton"
                                           AutomationProperties.AutomationId="PresetQualityButton"
                                           Content="품질형" Margin="0,0,8,0"
                                           Click="PresetQualityButton_Click"/>
                                <ui:Button x:Name="PresetStreamingButton"
                                           AutomationProperties.AutomationId="PresetStreamingButton"
                                           Content="스트리밍형" Margin="0,0,8,0"
                                           Click="PresetStreamingButton_Click"/>
                                <ui:Button x:Name="PresetCustomButton"
                                           AutomationProperties.AutomationId="PresetCustomButton"
                                           Content="사용자정의"
                                           Click="PresetCustomButton_Click"/>
                            </StackPanel>

                            <!-- TTS 설정 섹션 -->
                            <TextBlock Text="TTS (음성 합성) 설정" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,16,0,8"/>

                            <!-- TTS 모델 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TTS 모델" VerticalAlignment="Center" FontSize="12"/>
                                <ui:TextBox x:Name="TtsModelTextBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="TtsModelTextBox"
                                           PlaceholderText="tts-1"/>
                            </Grid>

                            <!-- TTS 음성 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TTS 음성" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox x:Name="TtsVoiceComboBox" Grid.Column="1"
                                          AutomationProperties.AutomationId="TtsVoiceComboBox"
                                          Width="160" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="alloy" Tag="alloy"/>
                                    <ComboBoxItem Content="echo" Tag="echo"/>
                                    <ComboBoxItem Content="fable" Tag="fable"/>
                                    <ComboBoxItem Content="onyx" Tag="onyx"/>
                                    <ComboBoxItem Content="nova" Tag="nova"/>
                                    <ComboBoxItem Content="shimmer" Tag="shimmer"/>
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </Expander>
                </Border>

                <!-- TinyMCE 에디터 설정 -->
                <Border x:Name="TinyMCEBorder" Margin="0,0,0,12" Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="TinyMCE 에디터" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="TinyMCEStatusText" Text="" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="메일 작성 시 사용하는 TinyMCE 리치 텍스트 에디터의 API 키입니다."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,12" FontSize="12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <ui:PasswordBox x:Name="TinyMCEApiKeyBox" Grid.Column="1"
                                               AutomationProperties.AutomationId="TinyMCEApiKeyBox"
                                               PlaceholderText="your-api-key..."
                                               RevealButtonEnabled="True"/>
                            </Grid>
                            <TextBlock Margin="100,0,0,0">
                                <Hyperlink NavigateUri="https://www.tiny.cloud/auth/signup/"
                                           RequestNavigate="TinyMCEGetKeyLink_RequestNavigate">
                                    <Run Text="API 키 발급받기 (tiny.cloud)"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 하단 버튼 -->
        <Border Grid.Row="2" Padding="24,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SaveStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button AutomationProperties.AutomationId="CancelButton"
                               Content="취소"
                               Appearance="Secondary"
                               Width="100"
                               Margin="0,0,8,0"
                               Click="CancelButton_Click"/>
                    <ui:Button x:Name="SaveButton"
                               AutomationProperties.AutomationId="SaveButton"
                               Content="저장"
                               Appearance="Primary"
                               Width="100"
                               IsEnabled="False"
                               Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
